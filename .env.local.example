# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL — use localhost for dev, your Vercel URL for production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slack webhooks are configured in Hub Settings → Slack Channels.
# SLACK_WEBHOOK_URL is ignored so it cannot override those Settings URLs.

# Slack bot token (same Slack app as the incoming webhooks). Required to create per-client channels.
# Bot scopes: channels:manage, channels:read, channels:join, chat:write, canvases:write, bookmarks:write
# Reinstall the app after adding scopes, then paste the Bot User OAuth Token (xoxb-…).
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Protects GET/POST /api/cron/client-weekly-digest (Vercel Cron sends this automatically)
CRON_SECRET=generate-a-long-random-string

# Shared secret for POST /api/webhooks/supabase-platform (Supabase org webhooks → Slack Alerts).
# Generate a long random string. The register script sends it as Authorization: Bearer …
SUPABASE_PLATFORM_WEBHOOK_SECRET=generate-a-long-random-string

# Used only by tools/register-supabase-org-slack-webhook.mjs (not the Next.js app).
# Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
